{
  "name": "universe-status",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "office": "npm --prefix office run start",
    "office:mock": "npm --prefix office run mock",
    "office:assign": "npm --prefix office run assign --",
    "test:worker-office": "node scripts/classify-test.mjs && node scripts/spool-hook-test.mjs && node scripts/worker-office-core-replay.ts --no-real && node scripts/worker-office-traffic-sim.ts",
    "test:worker-office-map": "node scripts/worker-office-map-check.ts && node scripts/worker-office-walk-smoke.ts && node scripts/worker-office-render-check.ts && node scripts/worker-office-places-check.ts",
    "test:worker-office-art": "node scripts/worker-office-art-check.ts",
    "check:worker-office-visual": "node scripts/worker-office-visual-check.mjs",
    "check:worker-office-example": "node scripts/worker-office-example-shot.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -v && node node_modules/typescript/bin/tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@types/three": "^0.183.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright-core": "^1.61.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
