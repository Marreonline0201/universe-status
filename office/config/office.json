{
  "port": 4571,
  "maxConcurrent": 8,
  "maxTurns": 30,
  "activationTimeoutMs": 1200000,
  "agentCooldownMs": 30000,
  "noProgressBackoffMs": 300000,
  "allowedTools": "Read,Glob,Grep,Write,Edit,WebSearch,WebFetch,Agent",
  "fableFallbackModel": "claude-opus-4-8",
  "autoCommit": true,
  "autoCommitBranch": "agent-office",
  "autoCommitIntervalMs": 120000,
  "usageRest": {
    "sessionThresholdPct": 90,
    "weeklyThresholdPct": 80,
    "pollSeconds": 60
  },
  "session": {
    "maxContextTokens": 60000,
    "injectMemory": "fresh"
  },
  "runner": {
    "enabled": true,
    "defaultTimeoutMs": 600000,
    "maxTimeoutMs": 1800000,
    "maxOutputLines": 2000,
    "maxOutputBytes": 2000000,
    "cwds": {
      "universe-status": ".",
      "universe-engine": "../universe-engine"
    },
    "engineWorktree": {
      "path": "../universe-engine-lab",
      "branch": "lab/agent-experiments",
      "baseRepo": "../universe-engine"
    },
    "commands": [
      {
        "bin": "cargo",
        "subcommands": [
          "check",
          "build",
          "test",
          "clippy",
          "fmt",
          "bench"
        ],
        "cwds": [
          "universe-engine"
        ],
        "maxArgs": 12
      },
      {
        "bin": "cargo",
        "subcommands": [
          "run"
        ],
        "cwds": [
          "universe-engine"
        ],
        "maxArgs": 12,
        "warn": "cargo run launches the app window on your machine and holds the run slot until it exits or times out"
      },
      {
        "bin": "node",
        "firstArgPattern": "^(office/spikes|scripts)/[A-Za-z0-9_\\-./]+\\.(mjs|js)$",
        "cwds": [
          "universe-status"
        ],
        "maxArgs": 8,
        "warn": "script content is not verified by the whitelist — check `git diff scripts/ office/spikes/` before approving; run-lab.mjs opens a Chrome window on your machine for ~30-60s"
      }
    ]
  },
  "vaultMirrorDir": "C:/Users/ddogr/ObsidianVault/universe-brain/research",
  "publicShare": {
    "allowedOrigins": [
      "https://universe-status.vercel.app",
      "https://universe-status-*-pioneer2026.vercel.app"
    ]
  }
}
